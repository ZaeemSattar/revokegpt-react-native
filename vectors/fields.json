{
  "suite": "fields",
  "protocolVersion": 1,
  "description": "Request field charsets: input.field is action (^[A-Za-z0-9/_]{1,100}$) or cdata (^[A-Za-z0-9_-]{0,255}$); expected.valid says whether input.value is accepted. The whole string must match: a trailing or leading newline is invalid (in engines where $ also matches before a final newline, anchor with \\A and \\z or equivalent). Values are ASCII-only; any non-ASCII code point is invalid.",
  "cases": [
    { "name": "action: one word", "input": { "field": "action", "value": "login" }, "expected": { "valid": true } },
    { "name": "action: with slash", "input": { "field": "action", "value": "login/submit" }, "expected": { "valid": true } },
    { "name": "action: letters, digits, underscore", "input": { "field": "action", "value": "A_b/9" }, "expected": { "valid": true } },
    { "name": "action: single character", "input": { "field": "action", "value": "a" }, "expected": { "valid": true } },
    { "name": "action: 100 characters", "input": { "field": "action", "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expected": { "valid": true } },
    { "name": "action: empty", "input": { "field": "action", "value": "" }, "expected": { "valid": false } },
    { "name": "action: 101 characters", "input": { "field": "action", "value": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa" }, "expected": { "valid": false } },
    { "name": "action: space", "input": { "field": "action", "value": "log in" }, "expected": { "valid": false } },
    { "name": "action: trailing newline", "input": { "field": "action", "value": "login\n" }, "expected": { "valid": false } },
    { "name": "action: leading newline", "input": { "field": "action", "value": "\nlogin" }, "expected": { "valid": false } },
    { "name": "action: newline inside", "input": { "field": "action", "value": "log\nin" }, "expected": { "valid": false } },
    { "name": "action: trailing CR", "input": { "field": "action", "value": "login\r" }, "expected": { "valid": false } },
    { "name": "action: NUL", "input": { "field": "action", "value": "login\u0000" }, "expected": { "valid": false } },
    { "name": "action: hyphen", "input": { "field": "action", "value": "log-in" }, "expected": { "valid": false } },
    { "name": "action: dot", "input": { "field": "action", "value": "login.x" }, "expected": { "valid": false } },
    { "name": "action: Unicode letter (e acute)", "input": { "field": "action", "value": "logi\u00e9" }, "expected": { "valid": false } },
    { "name": "action: full-width letters", "input": { "field": "action", "value": "\uff4c\uff4f\uff47\uff49\uff4e" }, "expected": { "valid": false } },
    { "name": "action: Cyrillic homoglyph o", "input": { "field": "action", "value": "l\u043egin" }, "expected": { "valid": false } },
    { "name": "action: emoji", "input": { "field": "action", "value": "login\ud83d\ude00" }, "expected": { "valid": false } },
    { "name": "cdata: empty", "input": { "field": "cdata", "value": "" }, "expected": { "valid": true } },
    { "name": "cdata: letters, digits, underscore, hyphen", "input": { "field": "cdata", "value": "A-b_9" }, "expected": { "valid": true } },
    { "name": "cdata: 255 characters", "input": { "field": "cdata", "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }, "expected": { "valid": true } },
    { "name": "cdata: 256 characters", "input": { "field": "cdata", "value": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx" }, "expected": { "valid": false } },
    { "name": "cdata: space", "input": { "field": "cdata", "value": "a b" }, "expected": { "valid": false } },
    { "name": "cdata: trailing newline", "input": { "field": "cdata", "value": "abc\n" }, "expected": { "valid": false } },
    { "name": "cdata: leading newline", "input": { "field": "cdata", "value": "\nabc" }, "expected": { "valid": false } },
    { "name": "cdata: slash", "input": { "field": "cdata", "value": "a/b" }, "expected": { "valid": false } },
    { "name": "cdata: dot", "input": { "field": "cdata", "value": "a.b" }, "expected": { "valid": false } },
    { "name": "cdata: Unicode letter (e acute)", "input": { "field": "cdata", "value": "abc\u00e9" }, "expected": { "valid": false } },
    { "name": "cdata: emoji", "input": { "field": "cdata", "value": "\ud83d\ude00" }, "expected": { "valid": false } },
    { "name": "cdata: full-width letters", "input": { "field": "cdata", "value": "\uff4c\uff4f\uff47\uff49\uff4e" }, "expected": { "valid": false } }
  ]
}
